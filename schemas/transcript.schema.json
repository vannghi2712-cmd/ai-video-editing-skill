{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/transcript/1.0.0/transcript.schema.json",
  "title": "TranscriptV1",
  "description": "Canonical transcript output schema v1.0.0 (Draft 2020-12). segments exists ONLY at result.segments — root-level segments is forbidden.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "source",
    "engine",
    "request",
    "result",
    "alignment",
    "metrics",
    "warnings",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version; always '1.0.0' for this schema."
    },
    "status": {
      "type": "string",
      "enum": ["success", "failed", "partial"],
      "description": "Overall transcript status."
    },
    "source": {
      "type": "object",
      "required": ["path", "sha256", "duration_seconds", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "duration_seconds": { "type": "number" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "engine": {
      "type": "object",
      "required": ["name", "version", "asr_model", "device", "compute_type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "asr_model": { "type": "string" },
        "device": { "type": "string" },
        "compute_type": { "type": "string" }
      }
    },
    "request": {
      "type": "object",
      "description": "Normalized transcription request parameters.",
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "description": "Transcription output. segments exists ONLY here, NOT at root.",
      "required": ["segments", "full_text"],
      "additionalProperties": false,
      "properties": {
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/segment" }
        },
        "full_text": {
          "type": "string",
          "description": "Concatenation of all segment texts."
        }
      }
    },
    "alignment": {
      "type": "object",
      "required": [
        "requested_mode",
        "actual_status",
        "model_id",
        "model_fingerprint",
        "words_total",
        "words_aligned"
      ],
      "additionalProperties": false,
      "properties": {
        "requested_mode": { "type": "string" },
        "actual_status": { "type": "string" },
        "model_id": { "type": ["string", "null"] },
        "model_fingerprint": { "type": ["string", "null"] },
        "words_total": { "type": "integer", "minimum": 0 },
        "words_aligned": { "type": "integer", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Non-fatal warnings about the transcription."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "required": ["start", "end", "text", "words"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "number" },
        "end": { "type": "number" },
        "text": { "type": "string" },
        "words": {
          "type": "array",
          "items": { "$ref": "#/$defs/word" }
        }
      }
    },
    "word": {
      "type": "object",
      "required": ["word", "timing_status"],
      "additionalProperties": false,
      "properties": {
        "word": { "type": "string" },
        "timing_status": {
          "type": "string",
          "enum": ["aligned", "unaligned", "failed"]
        },
        "start": { "type": "number" },
        "end": { "type": "number" },
        "score": { "type": "number" }
      },
      "if": {
        "properties": { "timing_status": { "const": "aligned" } },
        "required": ["timing_status"]
      },
      "then": {
        "required": ["start", "end"],
        "description": "aligned words MUST have start and end"
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["start"] },
            { "required": ["end"] }
          ]
        },
        "description": "unaligned/failed words MUST NOT have start or end"
      }
    }
  }
}